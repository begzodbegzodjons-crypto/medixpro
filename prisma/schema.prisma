// UstozPro - Prisma schema (SQLite)
// O'qituvchilar uchun professional ta'lim platformasi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  emailVerified       DateTime?
  image               String?
  password            String?
  coinBalance         Float    @default(0)
  phone               String?
  phoneVerified       Boolean  @default(false)
  testsCompletedToday Int      @default(0)
  lastTestDate        String?
  isAdmin             Boolean  @default(false)
  isBlocked           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  testResults   TestResult[]
  transactions  Transaction[]
  purchases     Purchase[]
  library       Library[]
  accounts      Account[]
  sessions      Session[]
  createdCodes  AdminCode[]   @relation("AdminCodeCreator")
  redeemedCodes AdminCode[]   @relation("AdminCodeRedeemer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tests      Test[]
  materials  Material[]
}

model Test {
  id             String   @id @default(cuid())
  subjectId      String
  title          String
  description    String?
  // JSON-encoded array of { id, text, options[] }
  questions      String
  // JSON-encoded array of correct answer indices (parallel to questions)
  correctAnswers String
  passingScore   Int      @default(60)
  timeLimit      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject      Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  testResults  TestResult[]
}

model TestResult {
  id        String   @id @default(cuid())
  userId    String
  testId    String
  score     Float
  passed    Boolean
  answers   String?
  timeTaken Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String
  amount        Float
  description   String?
  balanceBefore Float?
  balanceAfter  Float?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Material {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String?
  fileUrl     String
  type        String // 'pdf', 'video'
  price       Float   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  purchases  Purchase[]
  library    Library[]
}

model Purchase {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  price      Float?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
}

model Library {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
}

model AdminCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String // 'admin', 'teacher'
  isUsed    Boolean   @default(false)
  usedById  String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdById String

  createdBy User  @relation("AdminCodeCreator", fields: [createdById], references: [id])
  usedBy    User? @relation("AdminCodeRedeemer", fields: [usedById], references: [id])
}

model CoinPackage {
  id        String   @id @default(cuid())
  name      String
  coins     Int
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Advertisement {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  fileType    String?
  position    String   @default("sidebar")
  isActive    Boolean  @default(true)
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
