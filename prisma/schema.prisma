// UstozPro - Prisma schema (SQLite)
// O'qituvchilar uchun professional ta'lim platformasi - kengaytirilgan versiya

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  emailVerified       DateTime?
  image               String?
  password            String?
  coinBalance         Float    @default(0)
  phone               String?
  phoneVerified       Boolean  @default(false)
  testsCompletedToday Int      @default(0)
  lastTestDate        String?
  isAdmin             Boolean  @default(false)
  isBlocked           Boolean  @default(false)
  // Teacher-specific
  subject             String? // Main teaching subject
  school              String? // School name
  district            String? // Tuman/shahar
  bio                 String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  testResults      TestResult[]
  transactions     Transaction[]
  purchases        Purchase[]
  library          Library[]
  favorites        Favorite[]
  lessonPlans      LessonPlan[]      @relation("LessonPlanAuthor")
  lessonMaterials  LessonMaterial[] @relation("LessonMaterialAuthor")
  notifications    Notification[]
  accounts         Account[]
  sessions         Session[]
  createdCodes     AdminCode[]   @relation("AdminCodeCreator")
  redeemedCodes    AdminCode[]   @relation("AdminCodeRedeemer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tests           Test[]
  materials       Material[]
  topics          Topic[]
  lessonPlans     LessonPlan[]
  lessonMaterials LessonMaterial[]
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  subject          Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessonPlans      LessonPlan[]
  lessonMaterials  LessonMaterial[]

  @@index([subjectId])
}

model Test {
  id             String   @id @default(cuid())
  subjectId      String
  title          String
  description    String?
  // JSON-encoded array of { id, text, options[] }
  questions      String
  // JSON-encoded array of correct answer indices (parallel to questions)
  correctAnswers String
  passingScore   Int      @default(60)
  timeLimit      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject      Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  testResults  TestResult[]

  @@index([subjectId])
  @@index([createdAt])
}

model TestResult {
  id        String   @id @default(cuid())
  userId    String
  testId    String
  score     Float
  passed    Boolean
  answers   String?
  timeTaken Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
  @@index([createdAt])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String
  amount        Float
  description   String?
  balanceBefore Float?
  balanceAfter  Float?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Material {
  id          String   @id @default(cuid())
  subjectId   String
  title       String
  description String?
  fileUrl     String
  type        String // 'pdf', 'video', 'document', 'presentation'
  price       Float   @default(0)
  // Free materials available to all teachers
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  purchases  Purchase[]
  library    Library[]
  favorites  Favorite[]

  @@index([subjectId])
  @@index([createdAt])
  @@index([isFree])
}

model Purchase {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  price      Float?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
}

model Library {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  materialId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
}

// Dars ish rejalari - Lesson plans
model LessonPlan {
  id          String   @id @default(cuid())
  subjectId   String
  topicId     String?
  title       String
  description String?
  // JSON-encoded structured content
  // { objectives, materials, stages, homework, assessment }
  content     String
  // Class level: 5, 6, 7, 8, 9, 10, 11
  classLevel  Int?
  // Lesson duration in minutes
  duration    Int      @default(45)
  // Author
  authorId    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  author  User?   @relation("LessonPlanAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([subjectId])
  @@index([topicId])
  @@index([classLevel])
  @@index([createdAt])
}

// Dars ishlanmalari - Lesson materials (teaching resources)
model LessonMaterial {
  id          String   @id @default(cuid())
  subjectId   String
  topicId     String?
  title       String
  description String?
  // JSON-encoded list of file URLs
  fileUrls    String
  // Material type: 'presentation', 'worksheet', 'test', 'video', 'document'
  type        String
  classLevel  Int?
  authorId    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  author  User?   @relation("LessonMaterialAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([subjectId])
  @@index([topicId])
  @@index([classLevel])
  @@index([type])
  @@index([createdAt])
}

model AdminCode {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String // 'admin', 'teacher'
  isUsed    Boolean   @default(false)
  usedById  String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdById String

  createdBy User  @relation("AdminCodeCreator", fields: [createdById], references: [id])
  usedBy    User? @relation("AdminCodeRedeemer", fields: [usedById], references: [id])
}

model CoinPackage {
  id        String   @id @default(cuid())
  name      String
  coins     Int
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Advertisement {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  fileType    String?
  position    String   @default("sidebar")
  isActive    Boolean  @default(true)
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([position])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
