# TiDB Cloud (MySQL-compatible) connection string for Prisma
# Note: We use USTOZPRO_DATABASE_URL because the sandbox environment
# sets DATABASE_URL to a SQLite path that cannot be overridden.
# ssl param is URL-encoded JSON: {"rejectUnauthorized":false}
# This bypasses hostname verification (TiDB cert CN doesn't match gateway hostname)
USTOZPRO_DATABASE_URL=mysql://2PS5aujUXSKBu38.root:Wko2XOaA6o8m1AAU@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/ustozpro?ssl=%7B%22rejectUnauthorized%22%3Afalse%7D

# For prisma db push CLI (allows invalid cert)
USTOZPRO_DATABASE_URL_CLI=mysql://2PS5aujUXSKBu38.root:Wko2XOaA6o8m1AAU@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/ustozpro?sslaccept=acceptinvalidcert

# NextAuth
NEXTAUTH_SECRET=ustoz-pro-jwt-secret-key-for-dev-32-chars

# Admin panel password
ADMIN_PASSWORD=Balandtoglar1

# Public URL (set on Cloudflare to your domain)
# NEXTAUTH_URL=https://your-domain.pages.dev
